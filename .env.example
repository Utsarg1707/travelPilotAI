# ============================================================
# TRAVELPILOT AI - ENVIRONMENT CONFIGURATION
# ============================================================

# Application Mode: 'demo' (free/simulated providers) or 'live'
APP_MODE=demo
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Host & Port
HOST=0.0.0.0
PORT=8000

# Primary LLM Provider: Groq (Free Tier)
# Get a free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048

# LangSmith Observability (Optional)
# Leave blank to run locally without LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=travelpilot-ai

# Database / Memory Checkpoint Persistence
DATABASE_URL=sqlite:///./travelpilot.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
