# ============================================================
# TRAVELPILOT AI - ENVIRONMENT CONFIGURATION
# ============================================================

# Application Mode & Runtime
APP_MODE=demo
ENVIRONMENT=production
LOG_LEVEL=INFO

# Backend Network Config (Render auto-injects PORT)
HOST=0.0.0.0
PORT=8000

# Primary LLM Provider: Groq (Free Tier API Key)
# Get a free key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048

# Database Connection
# Local Development: sqlite:///./travelpilot.db
# Cloud Production (Supabase Free PostgreSQL):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./travelpilot.db

# CORS Allowed Origins for Backend
# Local: ["http://localhost:3000","http://localhost:5173"]
# Production (Vercel Frontend URL): ["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Frontend Environment Variable (Vercel Build Environment)
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Optional LangSmith Tracing (Backend Only)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=travelpilot-ai
